-- Aides communes aux tests pgTAP de Sameva (incluses par \ir dans chaque test).
-- Tout est créé dans la transaction du test et disparaît au ROLLBACK final.

CREATE SCHEMA IF NOT EXISTS tests;

-- Les tests vérifient les règles de PRODUCTION : on annule les assouplissements
-- d'un environnement de développement (seed du banc ou de « supabase start »).
-- Tout est dans la transaction du test, donc annulé au ROLLBACK.
UPDATE public.game_config SET value = '10' WHERE key = 'quest.min_age_minutes_declaratif';
UPDATE public.game_config SET value = '50' WHERE key = 'quest.max_created_per_day';
GRANT USAGE ON SCHEMA tests TO anon, authenticated, service_role;

-- Crée un utilisateur Supabase et renvoie son id.
CREATE OR REPLACE FUNCTION tests.create_user(p_email text)
RETURNS uuid LANGUAGE plpgsql AS $$
DECLARE v_id uuid := gen_random_uuid();
BEGIN
  INSERT INTO auth.users (id, email) VALUES (v_id, p_email);
  -- En production, le déclencheur on_auth_user_created crée déjà le profil.
  INSERT INTO public.users (id, username, display_name) VALUES (v_id, split_part(p_email, '@', 1), split_part(p_email, '@', 1))
    ON CONFLICT (id) DO NOTHING;
  RETURN v_id;
END $$;

-- Agit comme l'app connectée (rôle authenticated + JWT).
CREATE OR REPLACE FUNCTION tests.login(p_id uuid)
RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  PERFORM set_config('request.jwt.claims',
    json_build_object('sub', p_id, 'role', 'authenticated')::text, true);
  EXECUTE 'SET LOCAL ROLE authenticated';
END $$;

-- Agit comme une Edge Function (service_role).
CREATE OR REPLACE FUNCTION tests.as_service()
RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  PERFORM set_config('request.jwt.claims', '{"role":"service_role"}', true);
  EXECUTE 'SET LOCAL ROLE service_role';
END $$;

-- Agit comme un visiteur non connecté.
CREATE OR REPLACE FUNCTION tests.as_anon()
RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  PERFORM set_config('request.jwt.claims', '{"role":"anon"}', true);
  EXECUTE 'SET LOCAL ROLE anon';
END $$;

-- Revient au rôle administrateur du test.
CREATE OR REPLACE FUNCTION tests.logout()
RETURNS void LANGUAGE plpgsql AS $$
BEGIN
  EXECUTE 'RESET ROLE';
  PERFORM set_config('request.jwt.claims', '', true);
END $$;

-- Crée une quête active « vieillie » (au-delà du délai de validation déclarative).
CREATE OR REPLACE FUNCTION tests.make_quest(
  p_user uuid, p_difficulty int DEFAULT 2, p_validation text DEFAULT 'manual',
  p_age interval DEFAULT interval '1 hour', p_deadline timestamptz DEFAULT NULL,
  p_category text DEFAULT 'Maison')
RETURNS uuid LANGUAGE plpgsql AS $$
DECLARE v_id uuid;
BEGIN
  INSERT INTO public.quests (user_id, title, difficulty, validation_type, category, deadline, deadline_at_creation, created_at, status)
  VALUES (p_user, 'Quête de test', p_difficulty, p_validation::public.validation_type, p_category, p_deadline, p_deadline, now() - p_age, 'active')
  RETURNING id INTO v_id;
  RETURN v_id;
END $$;

GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA tests TO anon, authenticated, service_role;

-- Défi de capture valide pour une quête (geste « pouce », nombre 42), sans tirage aléatoire.
CREATE OR REPLACE FUNCTION tests.challenge(p_user uuid, p_quest uuid)
RETURNS uuid LANGUAGE plpgsql AS $$
DECLARE v_id uuid;
BEGIN
  INSERT INTO public.oracle_challenges (user_id, quest_id, gesture_code, gesture_label, number_code, label, expires_at)
  VALUES (p_user, p_quest, 'pouce', 'un pouce levé', '42', 'un pouce levé, et le nombre 42 écrit sur un papier',
          now() + interval '3 minutes')
  RETURNING id INTO v_id;
  RETURN v_id;
END $$;
GRANT EXECUTE ON FUNCTION tests.challenge(uuid, uuid) TO anon, authenticated, service_role;
